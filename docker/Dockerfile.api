FROM node:20-alpine AS builder
WORKDIR /app
COPY package.json tsconfig.base.json ./
COPY packages/shared ./packages/shared
COPY apps/api ./apps/api
RUN npm install --prefix packages/shared --no-audit --no-fund && npm run build --prefix packages/shared
RUN npm install --prefix apps/api --install-links --no-audit --no-fund
RUN npx --prefix apps/api prisma generate --schema=apps/api/prisma/schema.prisma
RUN npm run build --prefix apps/api

FROM node:20-alpine
WORKDIR /app
RUN apk add --no-cache openssl
COPY --from=builder /app ./
EXPOSE 4000
CMD ["sh", "-c", "(apps/api/node_modules/.bin/prisma migrate deploy --schema=apps/api/prisma/schema.prisma || (apps/api/node_modules/.bin/prisma migrate resolve --applied 0001_init --schema=apps/api/prisma/schema.prisma && apps/api/node_modules/.bin/prisma migrate deploy --schema=apps/api/prisma/schema.prisma)) && node apps/api/dist/main.js"]
