# ==============================================================================
# LB DIGITAL CREATIONS — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env (development), .env.staging, or .env.production
# NEVER commit real secrets to version control.
# ==============================================================================

NODE_ENV=development
APP_ENV=development
PORT=4000
API_PREFIX=api/v1

# Public URLs (subdomains for production)
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_ADMIN_URL=http://localhost:3001
PUBLIC_API_URL=http://localhost:4000
PUBLIC_SITES_BASE_URL=http://localhost:3000/sites

# Database (PostgreSQL)
DATABASE_URL=postgresql://lbdc:lbdc_dev_password@localhost:5432/lbdc_db?schema=public

# Redis (Background Jobs & Rate Limiting / Caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication & Security
JWT_ACCESS_SECRET=replace_with_64_char_random_hex_secret_for_access_tokens
JWT_REFRESH_SECRET=replace_with_64_char_random_hex_secret_for_refresh_tokens
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
COOKIE_DOMAIN=localhost
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Google OAuth (Optional - enables Google Sign-In)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Razorpay Payment Gateway (Required for live/test Razorpay checkout & webhooks)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Media Storage (local | supabase | s3 | cloudinary)
STORAGE_PROVIDER=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=lbdc-media
LOCAL_UPLOAD_DIR=./uploads
SIGNED_URL_SECRET=replace_with_64_char_random_hex_secret_for_signed_urls
AWS_S3_BUCKET=
AWS_S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Transactional Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="LB Digital Creations <no-reply@lbdigitalcreations.in>"

# Firebase Cloud Messaging (Push Notifications)
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# WhatsApp Business Cloud API (Authorized Notifications)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# AI Service Layer (Optional - Gemini / OpenAI compatible)
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_DAILY_REQUEST_LIMIT_PER_USER=25

# Frontend Public Variables (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_RAZORPAY_KEY_ID=
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=
NEXT_PUBLIC_APP_NAME="LB Digital Creations"
