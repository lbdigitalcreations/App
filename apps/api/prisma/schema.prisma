generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// MULTI-TENANT SAAS FOUNDATION
// ============================================================================

model Tenant {
  id            String   @id @default(uuid()) @db.Uuid
  slug          String   @unique
  name          String
  customDomain  String?  @unique
  logoUrl       String?
  primaryColor  String   @default("#C5A15A")
  isActive      Boolean  @default(true)
  config        Json     @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  subscriptions    Subscription[]
  users            User[]
  services         Service[]
  templates        Template[]
  packages         Package[]
  orders           Order[]
  projects         Project[]
  celebrationSites CelebrationSite[]
  coupons          Coupon[]
  siteSettings     SiteSetting[]
  auditLogs        AuditLog[]

  @@map("tenants")
}

model Subscription {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  planName     String   @default("ENTERPRISE_FOUNDATION")
  status       String   @default("ACTIVE")
  maxOrders    Int      @default(100000)
  maxStorageMb Int      @default(102400)
  startsAt     DateTime @default(now())
  endsAt       DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("subscriptions")
}

// ============================================================================
// AUTHENTICATION, ROLES & PERMISSIONS
// ============================================================================

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique // CUSTOMER, ADMIN, SUPER_ADMIN, EMPLOYEE
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique // e.g. orders:read, orders:manage, settings:write
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @db.Uuid
  roleId            String    @db.Uuid
  email             String    @unique
  phone             String?   @unique
  passwordHash      String?
  googleId          String?   @unique
  isEmailVerified   Boolean   @default(false)
  isPhoneVerified   Boolean   @default(false)
  isActive          Boolean   @default(true)
  deletionRequested Boolean   @default(false)
  deletionRequestAt DateTime?
  referralCode      String    @unique
  referredById      String?   @db.Uuid
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  role             Role              @relation(fields: [roleId], references: [id])
  referredBy       User?             @relation("UserReferrals", fields: [referredById], references: [id])
  referredUsers    User[]            @relation("UserReferrals")
  profile          UserProfile?
  sessions         UserSession[]
  otpTokens        OtpToken[]
  orders           Order[]
  assignedProjects Project[]         @relation("AssignedAdmin")
  mediaAssets      MediaAsset[]
  studioDrafts     StudioDraft[]
  favorites        FavoriteTemplate[]
  revisions        Revision[]
  notifications    Notification[]
  referralsMade    Referral[]        @relation("Referrer")
  referralReceived Referral?         @relation("Referred")
  referralRewards  ReferralReward[]
  reviews          Review[]
  supportTickets   SupportTicket[]
  auditLogs        AuditLog[]
  aiUsageLogs      AiUsageLog[]

  @@index([tenantId])
  @@index([roleId])
  @@index([email])
  @@map("users")
}

model UserProfile {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @unique @db.Uuid
  fullName           String
  avatarUrl          String?
  city               String?
  state              String?
  country            String   @default("India")
  notifyInApp        Boolean  @default(true)
  notifyPush         Boolean  @default(true)
  notifyEmail        Boolean  @default(true)
  notifyWhatsapp     Boolean  @default(true)
  notifyPromotional  Boolean  @default(false)
  marketingConsent   Boolean  @default(false)
  fcmTokens          String[] @default([])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model UserSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String    @unique
  userAgent        String?
  ipAddress        String?
  deviceName       String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

model OtpToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String?   @db.Uuid
  target     String    // email or phone
  purpose    String    // EMAIL_VERIFY, PHONE_OTP, PASSWORD_RESET
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([target, purpose])
  @@map("otp_tokens")
}

// ============================================================================
// CATALOG: SERVICES (CATEGORIES), TEMPLATES, PACKAGES
// ============================================================================

model Service {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @db.Uuid
  slug               String
  title              String
  subtitle           String?
  description        String
  coverImageUrl      String?
  includedFeatures   Json      @default("[]")
  additionalFeatures Json      @default("[]")
  requirementsSchema Json      @default("[]")
  previewUrl         String?
  basePrice          Decimal   @db.Decimal(10, 2)
  displayOrder       Int       @default(0)
  isActive           Boolean   @default(true)
  isFeatured         Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  templates Template[]
  packages  Package[]
  orders    Order[]

  @@unique([tenantId, slug])
  @@index([tenantId, isActive, displayOrder])
  @@map("services")
}

model Template {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @db.Uuid
  serviceId         String    @db.Uuid
  slug              String
  name              String
  tagline           String?
  description       String
  coverImageUrl     String?
  previewImages     String[]  @default([])
  defaultThemeColor String    @default("#C5A15A")
  animationPreset   String    @default("elegant-fade")
  layoutConfig      Json      @default("{}")
  displayOrder      Int       @default(0)
  isActive          Boolean   @default(true)
  isFeatured        Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  tenant           Tenant             @relation(fields: [tenantId], references: [id])
  service          Service            @relation(fields: [serviceId], references: [id])
  features         TemplateFeature[]
  orders           Order[]
  favorites        FavoriteTemplate[]
  celebrationSites CelebrationSite[]

  @@unique([tenantId, slug])
  @@index([tenantId, serviceId, isActive])
  @@map("templates")
}

model TemplateFeature {
  id          String   @id @default(uuid()) @db.Uuid
  templateId  String   @db.Uuid
  key         String
  label       String
  description String?
  isIncluded  Boolean  @default(true)
  addOnPrice  Decimal  @default(0) @db.Decimal(10, 2)
  sortOrder   Int      @default(0)

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@map("template_features")
}

model FavoriteTemplate {
  userId     String   @db.Uuid
  templateId String   @db.Uuid
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@id([userId, templateId])
  @@map("favorite_templates")
}

model Package {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @db.Uuid
  serviceId          String?   @db.Uuid
  name               String
  slug               String
  description        String
  price              Decimal   @db.Decimal(10, 2)
  discountPercent    Decimal   @default(0) @db.Decimal(5, 2)
  deliveryDays       Int       @default(3)
  includedFeatures   Json      @default("[]")
  additionalFeatures Json      @default("[]")
  isPopular          Boolean   @default(false)
  isActive           Boolean   @default(true)
  displayOrder       Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  service Service? @relation(fields: [serviceId], references: [id])
  orders  Order[]

  @@unique([tenantId, slug])
  @@index([tenantId, isActive])
  @@map("packages")
}

// ============================================================================
// MOMENTS STUDIO, ORDERS & MEDIA ASSETS
// ============================================================================

model StudioDraft {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  serviceId  String?  @db.Uuid
  templateId String?  @db.Uuid
  packageId  String?  @db.Uuid
  payload    Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("studio_drafts")
}

model Order {
  id                String    @id @default(uuid()) @db.Uuid
  orderNumber       String    @unique
  tenantId          String    @db.Uuid
  customerId        String    @db.Uuid
  serviceId         String    @db.Uuid
  templateId        String    @db.Uuid
  packageId         String    @db.Uuid
  couponId          String?   @db.Uuid
  customerName      String
  customerEmail     String
  customerPhone     String
  basePrice         Decimal   @db.Decimal(10, 2)
  addOnsTotal       Decimal   @default(0) @db.Decimal(10, 2)
  additionalCharges Decimal   @default(0) @db.Decimal(10, 2)
  discountAmount    Decimal   @default(0) @db.Decimal(10, 2)
  taxAmount         Decimal   @default(0) @db.Decimal(10, 2)
  totalPrice        Decimal   @db.Decimal(10, 2)
  advanceAmount     Decimal   @db.Decimal(10, 2)
  balanceAmount     Decimal   @db.Decimal(10, 2)
  amountPaid        Decimal   @default(0) @db.Decimal(10, 2)
  paymentStatus     String    @default("PENDING")
  orderStatus       String    @default("SUBMITTED")
  internalNotes     String?
  rejectionReason   String?
  deadlineAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  tenant       Tenant             @relation(fields: [tenantId], references: [id])
  customer     User               @relation(fields: [customerId], references: [id])
  service      Service            @relation(fields: [serviceId], references: [id])
  template     Template           @relation(fields: [templateId], references: [id])
  package      Package            @relation(fields: [packageId], references: [id])
  coupon       Coupon?            @relation(fields: [couponId], references: [id])
  requirements OrderRequirement?
  mediaAssets  MediaAsset[]
  project      Project?
  payments     Payment[]
  invoices     Invoice[]
  review       Review?

  @@index([tenantId, customerId])
  @@index([orderStatus])
  @@index([paymentStatus])
  @@map("orders")
}

model OrderRequirement {
  id                String   @id @default(uuid()) @db.Uuid
  orderId           String   @unique @db.Uuid
  celebrationTitle  String
  honoreeNames      String
  eventDate         String
  eventTime         String?
  venueName         String?
  venueAddress      String?
  mapsUrl           String?
  description       String?
  themeColor        String   @default("#C5A15A")
  animationStyle    String   @default("elegant-fade")
  musicTrackId      String?
  countdownEnabled  Boolean  @default(true)
  galleryEnabled    Boolean  @default(true)
  rsvpEnabled       Boolean  @default(true)
  wishesEnabled     Boolean  @default(true)
  itinerary         Json     @default("[]")
  selectedAddOns    Json     @default("[]")
  requirementsText  String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_requirements")
}

model MediaAsset {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  orderId      String?  @db.Uuid
  projectId    String?  @db.Uuid
  category     String   @default("PHOTO") // PHOTO, VIDEO, AUDIO, REFERENCE, PROFILE, TEMPLATE
  originalName String
  mimeType     String
  sizeBytes    Int
  storageKey   String   @unique
  provider     String   @default("local") // local, s3, cloudinary
  isPrivate    Boolean  @default(true)
  createdAt    DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id])
  order   Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([orderId])
  @@map("media_assets")
}

// ============================================================================
// PROJECTS, STATUS HISTORY & REVISIONS
// ============================================================================

model Project {
  id              String    @id @default(uuid()) @db.Uuid
  referenceNumber String    @unique
  tenantId        String    @db.Uuid
  orderId         String    @unique @db.Uuid
  assignedAdminId String?   @db.Uuid
  status          String    @default("NEW")
  progressPercent Int       @default(0)
  description     String?
  workNotes       String?
  milestones      Json      @default("[]")
  previewUrl      String?
  finalUrl        String?
  startDate       DateTime?
  dueDate         DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  order           Order            @relation(fields: [orderId], references: [id])
  assignedAdmin   User?            @relation("AssignedAdmin", fields: [assignedAdminId], references: [id])
  updates         ProjectUpdate[]
  revisions       Revision[]
  mediaAssets     MediaAsset[]
  celebrationSite CelebrationSite?

  @@index([tenantId, status])
  @@index([assignedAdminId])
  @@map("projects")
}

model ProjectUpdate {
  id         String   @id @default(uuid()) @db.Uuid
  projectId  String   @db.Uuid
  fromStatus String?
  toStatus   String
  note       String?
  actorId    String?  @db.Uuid
  createdAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@map("project_updates")
}

model Revision {
  id                String    @id @default(uuid()) @db.Uuid
  projectId         String    @db.Uuid
  customerId        String    @db.Uuid
  revisionNumber    Int
  section           String
  description       String
  referenceAssetIds String[]  @default([])
  status            String    @default("REQUESTED")
  adminRemarks      String?
  revisedPreviewUrl String?
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  customer User    @relation(fields: [customerId], references: [id])

  @@index([projectId])
  @@map("revisions")
}

// ============================================================================
// PAYMENTS & INVOICES
// ============================================================================

model Payment {
  id                String    @id @default(uuid()) @db.Uuid
  orderId           String    @db.Uuid
  paymentType       String    // ADVANCE, BALANCE, FULL, ADDITIONAL_CHARGE
  provider          String    // RAZORPAY, MANUAL_UPI
  amount            Decimal   @db.Decimal(10, 2)
  currency          String    @default("INR")
  status            String    @default("PENDING") // PENDING, VERIFIED, FAILED, REFUNDED
  razorpayOrderId   String?   @unique
  razorpayPaymentId String?   @unique
  razorpaySignature String?
  upiReferenceId    String?
  upiProofAssetId   String?   @db.Uuid
  webhookEventId    String?   @unique
  verifiedByAdminId String?   @db.Uuid
  verifiedAt        DateTime?
  refundAmount      Decimal?  @db.Decimal(10, 2)
  refundReason      String?
  refundedAt        DateTime?
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  order   Order    @relation(fields: [orderId], references: [id])
  invoice Invoice?

  @@index([orderId])
  @@index([status])
  @@map("payments")
}

model Invoice {
  id              String   @id @default(uuid()) @db.Uuid
  invoiceNumber   String   @unique
  orderId         String   @db.Uuid
  paymentId       String?  @unique @db.Uuid
  customerName    String
  customerEmail   String
  customerPhone   String
  serviceTitle    String
  subtotal        Decimal  @db.Decimal(10, 2)
  discountAmount  Decimal  @default(0) @db.Decimal(10, 2)
  taxAmount       Decimal  @default(0) @db.Decimal(10, 2)
  totalAmount     Decimal  @db.Decimal(10, 2)
  amountPaid      Decimal  @db.Decimal(10, 2)
  balanceAmount   Decimal  @db.Decimal(10, 2)
  paymentStatus   String
  issuedAt        DateTime @default(now())
  createdAt       DateTime @default(now())

  order   Order    @relation(fields: [orderId], references: [id])
  payment Payment? @relation(fields: [paymentId], references: [id])

  @@index([orderId])
  @@map("invoices")
}

// ============================================================================
// CELEBRATION WEBSITE ENGINE & GUEST INTERACTIONS
// ============================================================================

model CelebrationSite {
  id                  String    @id @default(uuid()) @db.Uuid
  tenantId            String    @db.Uuid
  projectId           String    @unique @db.Uuid
  templateId          String    @db.Uuid
  slug                String    @unique
  status              String    @default("DRAFT") // DRAFT, PREVIEW, PUBLISHED, UNPUBLISHED, ARCHIVED
  isPasswordProtected Boolean   @default(false)
  accessPasswordHash  String?
  guestInteractionsOn Boolean   @default(true)
  seoTitle            String?
  seoDescription      String?
  qrCodeDataUrl       String?
  publishedAt         DateTime?
  unpublishedAt       DateTime?
  archivedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  tenant   Tenant         @relation(fields: [tenantId], references: [id])
  project  Project        @relation(fields: [projectId], references: [id])
  template Template       @relation(fields: [templateId], references: [id])
  content  SiteContent?
  guests   Guest[]
  rsvps    RsvpResponse[]
  wishes   Wish[]

  @@index([tenantId, status])
  @@index([slug])
  @@map("celebration_sites")
}

model SiteContent {
  id               String   @id @default(uuid()) @db.Uuid
  siteId           String   @unique @db.Uuid
  celebrationTitle String
  honoreeNames     String
  eventDate        String
  eventTime        String?
  venueName        String?
  venueAddress     String?
  mapsUrl          String?
  description      String?
  themeColor       String   @default("#C5A15A")
  animationStyle   String   @default("elegant-fade")
  musicUrl         String?
  countdownEnabled Boolean  @default(true)
  galleryEnabled   Boolean  @default(true)
  rsvpEnabled      Boolean  @default(true)
  wishesEnabled    Boolean  @default(true)
  itinerary        Json     @default("[]")
  galleryImages    Json     @default("[]")
  videoUrls        Json     @default("[]")
  customSections   Json     @default("{}")
  updatedAt        DateTime @updatedAt

  site CelebrationSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@map("site_content")
}

model Guest {
  id        String   @id @default(uuid()) @db.Uuid
  siteId    String   @db.Uuid
  name      String
  phone     String?
  email     String?
  groupName String?
  createdAt DateTime @default(now())

  site  CelebrationSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  rsvps RsvpResponse[]

  @@index([siteId])
  @@map("guests")
}

model RsvpResponse {
  id            String   @id @default(uuid()) @db.Uuid
  siteId        String   @db.Uuid
  guestId       String?  @db.Uuid
  guestName     String
  guestPhone    String?
  guestEmail    String?
  attending     String   // YES, NO, MAYBE
  attendeeCount Int      @default(1)
  message       String?
  isApproved    Boolean  @default(true)
  createdAt     DateTime @default(now())

  site  CelebrationSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  guest Guest?          @relation(fields: [guestId], references: [id], onDelete: SetNull)

  @@index([siteId, createdAt])
  @@map("rsvp_responses")
}

model Wish {
  id           String   @id @default(uuid()) @db.Uuid
  siteId       String   @db.Uuid
  guestName    String
  relationship String?
  message      String
  isApproved   Boolean  @default(true)
  createdAt    DateTime @default(now())

  site CelebrationSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, isApproved, createdAt])
  @@map("wishes")
}

// ============================================================================
// MARKETING: REFERRALS, COUPONS, REVIEWS
// ============================================================================

model Referral {
  id             String    @id @default(uuid()) @db.Uuid
  referrerId     String    @db.Uuid
  referredUserId String    @unique @db.Uuid
  status         String    @default("REGISTERED") // REGISTERED, QUALIFIED, REWARDED
  qualifiedAt    DateTime?
  createdAt      DateTime  @default(now())

  referrer     User             @relation("Referrer", fields: [referrerId], references: [id])
  referredUser User             @relation("Referred", fields: [referredUserId], references: [id])
  rewards      ReferralReward[]

  @@index([referrerId])
  @@map("referrals")
}

model ReferralReward {
  id           String    @id @default(uuid()) @db.Uuid
  referralId   String    @db.Uuid
  userId       String    @db.Uuid
  orderId      String    @unique @db.Uuid
  rewardAmount Decimal   @db.Decimal(10, 2)
  status       String    @default("CREDITED") // CREDITED, REDEEMED, REVOKED
  createdAt    DateTime  @default(now())

  referral Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("referral_rewards")
}

model Coupon {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @db.Uuid
  code            String
  description     String?
  discountType    String    // PERCENT, FIXED
  discountValue   Decimal   @db.Decimal(10, 2)
  minOrderAmount  Decimal   @default(0) @db.Decimal(10, 2)
  maxDiscountAmt  Decimal?  @db.Decimal(10, 2)
  usageLimit      Int?
  usedCount       Int       @default(0)
  startsAt        DateTime?
  endsAt          DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  orders Order[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@map("coupons")
}

model Review {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  orderId      String?  @unique @db.Uuid
  customerName String
  rating       Int      @default(5)
  title        String?
  comment      String
  isPublished  Boolean  @default(false)
  createdAt    DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id])
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([isPublished])
  @@map("reviews")
}

// ============================================================================
// NOTIFICATIONS, SUPPORT, SETTINGS, AI & AUDIT LOGS
// ============================================================================

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  event     String
  title     String
  body      String
  data      Json      @default("{}")
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs NotificationLog[]

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

model NotificationLog {
  id             String   @id @default(uuid()) @db.Uuid
  notificationId String   @db.Uuid
  channel        String   // IN_APP, PUSH, EMAIL, WHATSAPP
  recipient      String
  status         String   // QUEUED, SENT, FAILED, SKIPPED_UNCONFIGURED
  attempts       Int      @default(1)
  errorMessage   String?
  createdAt      DateTime @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@map("notification_logs")
}

model SupportTicket {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  orderId   String?  @db.Uuid
  subject   String
  message   String
  status    String   @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED
  adminNote String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("support_tickets")
}

model SiteSetting {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  key       String
  value     Json
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key])
  @@map("site_settings")
}

model AiUsageLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  feature   String
  tokensEst Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("ai_usage_logs")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  ipAddress  String?
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  actor  User?  @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
